# EduPath AI Environment Variables Configuration (.env.example)

# Application Settings
APP_NAME=EduPath AI
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501
SECRET_KEY=edupath-super-secret-development-key-change-in-production-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000

# Database Configuration
DATABASE_PATH=data/edupath.db

# Vector Database (ChromaDB) Configuration
CHROMA_PERSIST_DIRECTORY=data/chroma_db
DEFAULT_COLLECTION_NAME=edupath_knowledge

# Embeddings Configuration
# Options: offline_hash (zero-dep default), fastembed, sentence_transformer, gemini
EMBEDDING_PROVIDER=offline_hash
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# RAG & Retrieval Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
HYBRID_ALPHA=0.6  # 0.6 dense + 0.4 BM25
RELEVANCE_THRESHOLD=0.35
ENABLE_RERANKING=True

# LLM Providers Configuration
# Primary: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Fallback: Ollama Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Rate Limiting & Upload Security
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,txt,md
UPLOAD_STORAGE_DIR=data/uploads
